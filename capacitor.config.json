{
  "appId": "com.frontier.learningacademy",
  "appName": "UniCore",
  "webDir": "build",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://frontier-learning-academy.vercel.app",
    "cleartext": true,
    "allowNavigation": [
      "frontier-learning-academy.vercel.app",
      "frontier-learning-academy.onrender.com",
      "*.vercel.app"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_launcher",
      "iconColor": "#2C4B66"
    }
  }
}
